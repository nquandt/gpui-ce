<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.gpuice.iosgallery</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gpuigallery</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSCalendarsUsageDescription</key>
	<string>GPUI Gallery reads calendars to test the calendar integration.</string>
	<key>NSCameraUsageDescription</key>
	<string>GPUI Gallery uses the camera to test the camera preview and capture screen.</string>
	<key>NSContactsUsageDescription</key>
	<string>GPUI Gallery reads contacts to test the contacts integration.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>GPUI Gallery uses Face ID to test local authentication.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>GPUI Gallery uses the local network to test networking features.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>GPUI Gallery uses your location to test the location and maps screen.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>GPUI Gallery uses the microphone to test audio recording.</string>
	<key>NSMotionUsageDescription</key>
	<string>GPUI Gallery uses motion sensors to test the sensors screen.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>GPUI Gallery saves photos to test the image picker.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>GPUI Gallery reads photos to test the image picker.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
